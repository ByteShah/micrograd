   "source": [
    "from micrograd import MLP\n",
    "\n",
    "# Create a multi-layer perceptron\n",
    "model = MLP(3, [4, 4, 1])\n",
    "\n",
    "# Forward pass\n",
    "inputs = [2.0, 3.0, -1.0]\n",
    "output = model(inputs)\n",
    "\n",
    "# Backward pass -\n",
    "output.backward()\n",
    "\n",
    "# # Visualize computation graph\n",
    "from micrograd.engine import draw_dot\n",
    "dot = draw_dot(output)\n"
   ]
  }
 ],
